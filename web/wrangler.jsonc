{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opskills-web",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Run the Worker first so secondary domains can be redirected before assets are served.
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "opskills.app", "custom_domain": true },
    { "pattern": "getopskills.com", "custom_domain": true },
    { "pattern": "opskills.dev", "custom_domain": true }
  ]
}
